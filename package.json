{
  "name": "trace-engine-cli",
  "version": "0.2.0",
  "description": "CLI tool for inspecting Chromium performance traces on top of DevTools Trace Engine",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "trace-engine-cli": "./dist/bin/trace-engine-cli.js"
  },
  "files": [
    "dist/bin",
    "dist/src"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import fs from 'node:fs'; fs.rmSync('dist', {recursive: true, force: true});\"",
    "build": "npm run clean && tsc",
    "bundle:engine": "tsx scripts/bundle-engine.ts",
    "test": "node --test --import tsx/esm 'test/**/*.test.ts' 'test/*.test.ts'",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "trace",
    "devtools",
    "performance",
    "cli",
    "toon"
  ],
  "author": "Google LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChromeDevTools/trace-engine-cli.git"
  },
  "dependencies": {
    "@paulirish/trace_engine": "^0.0.68",
    "@toon-format/toon": "^4.1.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
